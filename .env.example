# KiraBot Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
SESSION_SECRET=kirabot-secret-change-this-in-production

# Optional: Claude AI API for enhanced NLP (https://console.anthropic.com)
# Leave blank to use the built-in rule-based NLP parser (fully functional)
CLAUDE_API_KEY=

# Optional: WhatsApp Business API (Meta Cloud API)
# Required only if connecting to real WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
